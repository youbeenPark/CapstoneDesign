  m_text: "\r\n\u2022 \uC810\uD504\uB97C \uB450\uBC88 \uB204\uB974\uBA74 \uB354\uBE14\uC810\uD504\uAC00
    \uB429\uB2C8\uB2E4.\n\r\n\u2022 \uAE30\uC5B5 \uC870\uAC01\uC744 \uCC59\uAE30\uC9C0
    \uBABB\uD558\uBA74 \uB2E4\uC74C \uC12C\uC774 \n\uC5F4\uB9AC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\r\n\r\n\u2022
